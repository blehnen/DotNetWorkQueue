<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Never shipped. Excluded from DotNetWorkQueueNoTests.sln so it stays out of the
         release build and pack gate. -->
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires an optimized build to produce meaningful numbers, and
         refuses to run a Debug build without this. Benchmarks are run with -c Release. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <!-- Deterministic builds are set repo-wide; BenchmarkDotNet generates and compiles its own
         auto-generated project per benchmark, which does not need SourceLink. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetWorkQueue\DotNetWorkQueue.csproj" />
    <ProjectReference Include="..\DotNetWorkQueue.Transport.SQLite\DotNetWorkQueue.Transport.SQLite.csproj" />
    <ProjectReference Include="..\DotNetWorkQueue.Transport.LiteDB\DotNetWorkQueue.Transport.LiteDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- used directly by the LiteDb rungs, which build a raw database as the ladder's floor -->
    <PackageReference Include="LiteDB" />
  </ItemGroup>

</Project>

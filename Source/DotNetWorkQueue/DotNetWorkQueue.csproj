<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0;</TargetFrameworks>
    <Authors>Brian Lehnen</Authors>
    <Company />
	  <Description>Work queue for dot net 8.0 and 10.0, and for .NET Framework and other netstandard2.0 runtimes. Supports scheduling, delayed processing, prioritized queues, message expiration, retries with configurable back-off and more.</Description>
    <Copyright>Copyright © Brian Lehnen 2015-2026</Copyright>
    <PackageProjectUrl>https://github.com/blehnen/DotNetWorkQueue</PackageProjectUrl>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/blehnen/DotNetWorkQueue</RepositoryUrl>
    <PackageReleaseNotes>See change log

https://github.com/blehnen/DotNetWorkQueue/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>Tasks Jobs Scheduler Threading Queues</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
		<DefineConstants>TRACE;DEBUG;CODE_ANALYSIS;LIBLOG_PUBLIC;LIBLOG_PORTABLE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
		<DefineConstants>TRACE;DEBUG;CODE_ANALYSIS;LIBLOG_PUBLIC;LIBLOG_PORTABLE</DefineConstants>
	</PropertyGroup>



	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0|AnyCPU'">
		<DefineConstants>LIBLOG_PUBLIC;LIBLOG_PORTABLE</DefineConstants>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors />
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
		<DefineConstants>LIBLOG_PUBLIC;LIBLOG_PORTABLE</DefineConstants>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors />
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|netstandard2.0|AnyCPU'">
		<DefineConstants>LIBLOG_PUBLIC;LIBLOG_PORTABLE</DefineConstants>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors />
	</PropertyGroup>


  <ItemGroup>
    <PackageReference Include="DotNetWorkQueue.Aq.ExpressionJsonSerializer" />
    <PackageReference Include="GuerrillaNtp" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="SimpleInjector" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="CronExpressionDescriptor" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- the SDK defaults this target to C# 7.3. The language version is a compiler setting, not a
         runtime one, so raising it costs nothing on a target that only lacks the newer runtime
         types; anything that does need runtime support is polyfilled under Compatibility. -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- part of the framework from net8.0 on; packages only for the old target -->
    <PackageReference Include="System.Text.Json" />
    <!-- 'dynamic' needs the runtime binder, which ships in the box everywhere except here -->
    <PackageReference Include="Microsoft.CSharp" />
    <!-- AES-GCM arrived in .NET Core 3.0 and was never backported, so there is no AesGcm to build
         against here and no way to produce the same envelope bytes without one. Encrypting with a
         different algorithm on this target would be worse than omitting it: the two builds could no
         longer read each other's messages, which is the whole point of shipping this target. -->
    <Compile Remove="Interceptors\AesMessageInterceptor.cs" />
  </ItemGroup>


  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
